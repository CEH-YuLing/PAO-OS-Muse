DATABASE_URL=postgresql+asyncpg://pao:CHANGE_ME@127.0.0.1:5432/pao
POSTGRES_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
REDIS_PASSWORD=
JWT_SECRET=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
RUN_TIMEOUT_SECONDS=180
CONTEXT_TOKENS=4096
OUTPUT_TOKENS=512
MEMORY_ENABLED=true
BRAIN_MANAGER_ENABLED=false
KNOWLEDGE_SOURCES_ENABLED=false
KNOWLEDGE_ENABLED=false
ENGINE_CONTRACT_ENABLED=false
# Installation resources reference native encrypted connections; publishing is
# limited to explicitly provisioned installation managers, not every SME owner.
INSTALLATION_AI_ENABLED=false
INSTALLATION_AI_MANAGER_IDS=[]
CHAT_FEATURES_ENABLED=false
STUDIO_ENABLED=false
BUSINESS_PLANNING_ENABLED=false
WORKFLOW_PLANNING_ENABLED=false
WORKFLOW_DURABLE_ENABLED=false
WORKFLOW_DISPATCH_ENABLED=false
WORKFLOW_WORKER_ENABLED=false
# P6.3B2a: admission ledger only, NOT a working goal executor.
GOAL_ADMISSION_ENABLED=false
# Internal first-iteration adapters only; live goal executor remains unavailable.
GOAL_ITERATIONS_ENABLED=false
# Versioned browser-independent dry-run runner; requires all Studio/Goal gates.
GOAL_RUNNER_ENABLED=false
STUDIO_SCHEDULE_MANAGER_ENABLED=false
STUDIO_SCHEDULE_DISPATCH_ENABLED=false
WORKFLOW_TEMPORAL_TASK_QUEUE=pao-studio-dryrun
CONNECTORS_ENABLED=false
BUSINESS_EVENTS_ENABLED=false
BUSINESS_EVENT_DELIVERY_ENABLED=false
UNIFIED_APPROVALS_ENABLED=false
KNOWLEDGE_EMBEDDINGS_ENABLED=true
AGENT_RUNTIME_ENABLED=true
JAVIS_COMPAT_SHADOW_ENABLED=true
TOOLS_ENABLED=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
ZALO_OA_ACCESS_TOKEN=
BOTCAKE_API_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
SEARXNG_URL=http://127.0.0.1:8888
# Run scripts/setup_search.py to set this value before enabling the search profile.
SEARXNG_SECRET=
AGENT_RUN_TIMEOUT_SECONDS=600
EMBEDDING_MODEL=embeddinggemma:300m
MEMORY_TIMEOUT_SECONDS=180
MEMORY_TOP_K=5
MEMORY_MIN_SIMILARITY=0.3

# Fresh installations use PAO names. Existing installations can map old storage
# without copying/deleting volumes; see docs/REBRAND-PAO.md.
POSTGRES_USER=pao
POSTGRES_DB=pao
PAO_POSTGRES_VOLUME=pao_postgres-data
PAO_REDIS_VOLUME=pao_redis-data
PAO_EXTERNAL_STORAGE=false
# Optional: PAO_ROOT overrides the backend repository root.
# Optional: PAO_API_URL sets the Next.js backend URL at build time.
# Optional: DOCKER_EXECUTABLE overrides Docker discovery from PATH.
DOCKER_EXECUTABLE=

# Phase 6: off until token and explicit whitelist are configured.
TELEGRAM_ENABLED=false
# S3.2 candidate: keep disabled until scoped setup/activation acceptance.
TELEGRAM_SCOPED_RUNTIME_ENABLED=false
# Public HTTPS origin for scoped webhook setup; empty keeps local polling only.
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Phase 7: disabled until configured with scripts/setup_meta.py.
META_ENABLED=false
RESULT_INBOX_ENABLED=false
LEARNING_REVIEW_ENABLED=false
OUTCOME_OBSERVATIONS_ENABLED=false
META_WRITE_ENABLED=false
META_WRITE_MAX_BUDGET_CHANGE_PCT=20
ADS_APPROVAL_TTL_HOURS=24
ADS_AUTOPILOT_GLOBAL_ENABLED=false
META_AUTOPILOT_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_REDIRECT_URI=http://localhost:3100/v1/integrations/meta/callback
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_REDIRECT_URI=http://localhost:3100/v1/integrations/google-ads/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
INTEGRATION_ENCRYPTION_KEY=

# Phase 17: self-hosted Temporal. Keep disabled until the Temporal service and
# dedicated worker are running.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pao-automation
TEMPORAL_WORKFLOW_TIMEOUT_DAYS=30

# Phase 18: audio stays local. Run scripts/setup_voice.py before enabling.
VOICE_ENABLED=false
VOICE_TURNS_ENABLED=false
CHANNELS_ENABLED=false
# Optional stable local HMAC key, >=32 chars; never commit a real key.
# Without it, identity hashes depend on JWT_SECRET. Rotate only with channels quiet.
CHANNEL_IDENTITY_KEY=
CHANNEL_AUTOREPLY_ENABLED=false
# Retention days alone do not authorize content deletion. Keep off until a
# separate retention policy and explicit activation are approved.
CHANNEL_RETENTION_ENABLED=false
VOICE_STT_MODEL_PATH=.runtime/models/faster-whisper-small
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE_TYPE=int8
VOICE_TTS_PROVIDER=windows_sapi
VOICE_TTS_EXECUTABLE=
VOICE_TTS_MODEL_PATH=
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_SECONDS=30
# Private legacy Meta installer only; keep false on shared SaaS. SME App ID/
# Secret settings use the encrypted tenant-app API and never edit this file.
META_INSTALLATION_CONFIG_ENABLED=false
